PORT=5000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mdrrmo_db
DB_PASSWORD=admin123
DB_PORT=5432
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# --- Forgot-password PIN delivery (optional) ---------------------------
# Leave any of these blank to fall back to logging the PIN to the server
# console (fine for local dev). Fill them in for real email/SMS delivery.

# Email (Gmail example): use a 16-char Google "App Password", not your
# normal Gmail password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="RESCOM <your_gmail_address@gmail.com>"

# SMS (any HTTP SMS gateway, e.g. Semaphore/Twilio-compatible). Left blank
# by default — PIN is logged to console instead.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=RESCOM
